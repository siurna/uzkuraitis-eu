# Eurovision party app, environment-variable manifest.
#
# Copy this file to `.env.local` (gitignored) and fill in the values.
# Every key referenced anywhere in `app/`, `lib/`, or `components/` is
# listed here; if a deploy is missing one the failure mode is in the
# block-comment above the line.

# ─── Database ─────────────────────────────────────────────────────────
# Supabase Postgres connection string. Use the POOLER URL (port 6543)
# for the runtime — Drizzle on a serverless lambda can't hold a long-
# lived connection. Without this the app can't read or write anything.
DATABASE_URL=postgres://postgres.<project>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Direct (non-pooler) Postgres URL, used for one-off migration scripts
# and the `lib/db.ts` admin path. Same project, different port (5432).
# Optional; falls back to DATABASE_URL when not set.
SUPABASE_POSTGRES_URL=postgres://postgres:<password>@db.<project>.supabase.co:5432/postgres

# ─── Supabase Realtime + Storage ──────────────────────────────────────
# Broadcast/subscribe goes through Supabase Realtime; storage is the
# image / icon bucket. NEXT_PUBLIC_ are shipped to the client and
# safe to expose. SERVICE_ROLE is server-only — it bypasses RLS, treat
# it like a master password.
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ─── Session secrets ──────────────────────────────────────────────────
# Voter cookie HMAC — signs the session-id cookie so it can't be
# spoofed. Any 32+ byte hex string works (`openssl rand -hex 32`).
UZK_SESSION_SECRET=<random-hex>

# Admin JWT secret — signs the admin cookie issued after passkey
# login. Separate from UZK_SESSION_SECRET so a compromised voter
# session can't be lifted into an admin one.
ADMIN_SESSION_SECRET=<random-hex>

# One-shot bootstrap token for enrolling the FIRST admin passkey.
# Once the first passkey is registered this can be rotated /
# deleted; subsequent admins are enrolled from inside the dashboard.
ADMIN_BOOTSTRAP_SECRET=<random-hex>

# ─── Passkey (WebAuthn) ───────────────────────────────────────────────
# Origin the browser sees + the matching Relying Party ID. RP_ID is
# usually the bare hostname (no scheme, no port). LOCAL DEV: set
# ORIGIN=http://localhost:3000 and RP_ID=localhost.
WEBAUTHN_ORIGIN=https://uzkuraitis.eu
WEBAUTHN_RP_ID=uzkuraitis.eu

# ─── Web Push (VAPID) ─────────────────────────────────────────────────
# Generate once with `npx web-push generate-vapid-keys`. The PUBLIC
# key is shipped to the client during subscription; the PRIVATE key
# stays on the server. SUBJECT is an admin contact mailto: that some
# push services require.
VAPID_PUBLIC_KEY=<base64url-public-key>
VAPID_PRIVATE_KEY=<base64url-private-key>
VAPID_SUBJECT=mailto:hello@uzkuraitis.eu

# ─── AI (Anthropic) ───────────────────────────────────────────────────
# Powers Beginner-mode "explain this Eurovision moment" tooltips +
# the EN-language live translation of LT chat. App degrades quietly
# without this — the toggle just stays a no-op.
ANTHROPIC_API_KEY=<sk-ant-…>
# Optional model overrides. Default to whatever lib/ai.ts hard-codes.
ANTHROPIC_EXPLAIN_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_TRANSLATE_MODEL=claude-haiku-4-5-20251001

# ─── GIF search (Klipy) ───────────────────────────────────────────────
# Chat composer's GIF picker. Without this, the GIF button shows
# "search unavailable" and only the recent / favourite tabs work.
KLIPY_API_KEY=<klipy-key>

# ─── Cloudflare Turnstile ─────────────────────────────────────────────
# Anti-bot challenge on the room-join gate. The SITE key is public;
# the SECRET is server-side. Pair them or the gate will reject every
# real visitor.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=<site-key>
TURNSTILE_SECRET_KEY=<secret-key>

# ─── Cron ─────────────────────────────────────────────────────────────
# Vercel cron pings /api/cron/keep-alive once a day with this header
# to keep the Supabase pooler warm. Any random string the cron job
# sends as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=<random-hex>
